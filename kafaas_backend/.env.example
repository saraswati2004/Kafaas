# KaFaaS Backend Environment Configuration
APP_ENV=development
APP_NAME=KaFaaS Backend
DEBUG=true
PORT=8000

# Database Connection (PostgreSQL / Supabase connection or local SQLite for testing)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/kafaas_db
DATABASE_URL=sqlite+aiosqlite:///./kafaas.db

# Supabase Auth Configuration
SUPABASE_URL=https://owaaxzfmsncgcmwrzqzq.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_change_in_production
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_never_share

# Google SSO Mobile Reference
GOOGLE_ANDROID_PACKAGE=com.kafaas.kafaas_mobile_app

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
