# ══════════════════════════════════════════════════════════════════
#  KaFaaS — .gitignore
#  Files in this file are NOT pushed to GitHub.
# ══════════════════════════════════════════════════════════════════

# ── Node.js / Frontend ─────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.local
.vite-env.d.ts.*
*.tsbuildinfo

# Vite / build caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Python / Backend ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
develop-eggs/
dist/
downloads/
parts/
sdist/
wheels/
share/python-wheels/
*.manifest
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.htmlcov/
.coverage
.coverage.*
.hypothesis/
.tox/
.nox/
.coverage.*
.venv/
venv/
ENV/
env/
*.pyd
*.so

# ── Databases (never commit local data) ────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Environment / Secrets ──────────────────────────────────────────
# Never commit real environment files or secrets
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.production

# ══════════════════════════════════════════════════════════════════
#  Root-level project files
# ══════════════════════════════════════════════════════════════════

# Logs / runtime
*.log
dev.log
logs/

# ── OS files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*~

# ── Editor / IDE ───────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.settings/
.classpath

# ── Agent / scratch files ──────────────────────────────────────────
.agents/
.scratch/

# ── Misc ───────────────────────────────────────────────────────────
*.orig
*.rej
.Directory
